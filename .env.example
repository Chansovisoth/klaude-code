# klaude-code environment secrets.
# scripts/install.sh copies this to .env and fills in generated values.
# .env is gitignored — never commit it.
#
# All keys are optional. Klaude skips providers with empty, invalid, unavailable,
# rate-limited, or exhausted credentials. Provider limits may change.

# ====================
# LOCAL / KEYLESS SEARCH
# ====================
SEARXNG_SECRET=       # URL: https://docs.searxng.org/ | Limit: No account, card, or fixed quota; upstream engines may throttle or block requests
# NOTE: cookie/session secret (any long random hex string)
# DDGS requires no environment variable or API key.
# URL: https://github.com/deedy5/ddgs | Limit: No account or fixed quota; upstream engines may throttle or block requests

# ====================
# SEARCH ENGINES
# ====================
GEMINI_API_KEY=       # URL: https://aistudio.google.com/apikey | Limit: Billing required; monthly grounded-search allowance applies, but Gemini tokens may still cost money
PARALLEL_API_KEY=     # URL: https://platform.parallel.ai/ | Limit: Free monthly credit may be available; card and allowance requirements depend on the current plan
TAVILY_API_KEY=       # URL: https://app.tavily.com/ | Limit: 1,000 credits/month; Basic uses 1 credit and Advanced uses 2; no card required
EXA_API_KEY=          # URL: https://dashboard.exa.ai/ | Limit: Signup and recurring monthly credits may be available; no payment method required for the free allowance

# ====================
# WEB FETCHING / CRAWLING
# ====================
CRAWL4AI_API_KEY=     # URL: https://api.crawl4ai.com/ | Limit: Cloud limits depend on the plan; local self-hosting requires no key or card
FIRECRAWL_API_KEY=    # URL: https://www.firecrawl.dev/app | Limit: Free monthly credits available; search, scrape, and crawl operations consume different amounts

# ====================
# MODEL / DATA PLATFORMS
# ====================
HUGGINGFACE_API_KEY=  # URL: https://huggingface.co/settings/tokens | Limit: Free Hub access uses rate limits; no card required for standard access
