# klaude-code environment secrets.

# scripts/install.sh copies this to config/.env and fills in generated values.
# config/.env and root .env are gitignored -- never commit real secrets.

# Ollama chat options live in config.toml under [ollama.options].
# Host systemd Ollama services do not read this file unless you explicitly wire
# it into the service. Keep API secrets below local and gitignored.

# All keys are optional. Klaude skips providers with empty, invalid, unavailable,
# rate-limited, or exhausted credentials. Provider limits may change.

# ====================
# PROVIDER KEYS
# ====================

# SEARCH ENGINES
# DDGS:               no environment variable or API key | URL: https://github.com/deedy5/ddgs | Limit: No account or fixed quota; upstream engines may throttle or block requests
# SearXNG uses config/searxng.env for its local service secret.
GEMINI_API_KEY=       # Google: URL: https://aistudio.google.com/apikey | Limit: Billing required; monthly grounded-search allowance applies, but Gemini tokens may still cost money
PARALLEL_API_KEY=     # Parallel: URL: https://platform.parallel.ai/ | Limit: Free monthly credit may be available; card and allowance requirements depend on the current plan
TAVILY_API_KEY=       # Tavily: URL: https://app.tavily.com/ | Limit: 1,000 credits/month; Basic uses 1 credit and Advanced uses 2; no card required
EXA_API_KEY=          # Exa: URL: https://dashboard.exa.ai/ | Limit: Signup and recurring monthly credits may be available; no payment method required for the free allowance
FIRECRAWL_API_KEY=    # Firecrawl: URL: https://www.firecrawl.dev/app | Limit: Optional hosted search/fetch/crawl provider; free monthly credits available; operation costs differ

# WEB FETCHING / CRAWLING
# DIRECT TEXT FETCH:  no environment variable or API key | fetch_url tries plain text/Markdown/JSON/XML first
# TRAFILATURA:        no environment variable or API key | local Python HTML extraction fallback
# CRAWL4AI (LOCAL):   no API key | configure crawl4ai_url in config.toml
CRAWL4AI_API_KEY=     # Crawl4AI Cloud: URL: https://api.crawl4ai.com/ | Limit: Cloud limits depend on the plan; local self-hosting requires no key or card
# FIRECRAWL:          also uses FIRECRAWL_API_KEY above for hosted fetch/crawl

# MODEL / DATA PLATFORMS
HUGGINGFACE_API_KEY=  # Hugging Face: URL: https://huggingface.co/settings/tokens | Limit: Free Hub access uses rate limits; no card required for standard access
