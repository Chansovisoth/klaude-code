# klaude-code optional provider credentials
#
# scripts/install.sh copies this file to config/.env. That local file is
# gitignored: add real values there, never to this example or the repository.
# Leave a value blank to disable its provider. Klaude skips unavailable,
# invalid, rate-limited, and exhausted credentials.
#
# Ollama options belong in config.toml under [ollama.options]. A host Ollama
# service does not read this file unless its launcher explicitly wires it in.

# ── Cloud chat models ───────────────────────────────────────────────────────
# OpenAI cloud-model access in /model.
# Create a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini cloud-model access in /model; also enables the Google web-search provider.
# Create a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Web search ──────────────────────────────────────────────────────────────
# Parallel web-search provider.
# Create a key: https://platform.parallel.ai/
PARALLEL_API_KEY=

# Tavily web-search provider.
# Create a key: https://app.tavily.com/
TAVILY_API_KEY=

# Exa web-search provider, including its search highlights.
# Create a key: https://dashboard.exa.ai/
EXA_API_KEY=

# ── Hosted web fetching and crawling ────────────────────────────────────────
# Firecrawl hosted search, URL fetching, and same-domain crawling provider.
# Create a key: https://www.firecrawl.dev/app
FIRECRAWL_API_KEY=

# Crawl4AI Cloud URL-fetching and crawling provider. Local Crawl4AI needs no
# key; configure its endpoint with crawl4ai_url in config.toml instead.
# Create a Cloud key: https://api.crawl4ai.com/
CRAWL4AI_API_KEY=

# ── Model and data platform ─────────────────────────────────────────────────
# Hugging Face Hub authentication for model, dataset, and Space searches.
# Create a token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ── Keyless or separately configured services ───────────────────────────────
# DDGS search needs no environment variable or API key: https://github.com/deedy5/ddgs
# Direct text fetching and the local Trafilatura fallback need no key.
# SearXNG's local service secret is kept separately in config/searxng.env.
